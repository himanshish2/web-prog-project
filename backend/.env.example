# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- MongoDB Atlas (never commit the real value) ----
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/campuscarry

# ---- Sessions (use a long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Frontend ----
# Comma-separated list of frontend origins allowed to call the API (no trailing slash).
# 'localhost' and '127.0.0.1' are DIFFERENT origins - use the one you open in the browser.
CLIENT_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
# Where to send the student after they click the email-verification link
CLIENT_URL=http://localhost:5500
VERIFY_REDIRECT_PATH=/login.html
# Public URL of THIS backend (used to build the verification link in emails)
BACKEND_URL=http://localhost:5000

# ---- Email verification ----
# Comma-separated permitted university email domains. CONFIRM the exact domain with the university.
# Leave empty to skip the domain check (development only).
ALLOWED_EMAIL_DOMAINS=bmu.edu.in
# Set to false ONLY for local testing without SMTP
REQUIRE_EMAIL_VERIFICATION=true

# SMTP — Gmail example (works with any Nodemailer-compatible provider).
# If SMTP_HOST is left empty the verification link is printed in the server
# console instead of being emailed (useful for local dev without SMTP).
#
# Gmail setup:
#   1. Enable 2-Step Verification on your Google Account.
#   2. Go to https://myaccount.google.com/apppasswords and create an App Password.
#   3. Fill in the values below with that 16-character App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="CampusCarry <your-email@gmail.com>"

# ---- Cookies (production) ----
# Frontend and backend on DIFFERENT domains (e.g. Netlify + Render): COOKIE_SAMESITE=none (needs HTTPS)
# Same domain/site: COOKIE_SAMESITE=lax
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
# TRUST_PROXY=1

# ---- Admin bootstrap (used only by `npm run create-admin`) ----
# ADMIN_NAME=Admin
# ADMIN_EMAIL=admin@bmu.edu.in
# ADMIN_PASSWORD=use-a-strong-password-here
